# Copy this file to .env and paste your keys after the = signs. Never commit .env.
# harness.py reads .env at startup; a variable already set in the terminal wins.

GROQ_API_KEY=        # https://console.groq.com/keys (free tier works)
GEMINI_API_KEY=      # optional backup model: https://aistudio.google.com/apikey

# Optional settings
# HARNESS_PROVIDER=gemini        # default model at startup (groq or gemini); the UI menu can still switch
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_RPM=5                   # Gemini requests per minute (raise it on a paid tier)
